# Per-file warning flags, the qmake equivalent of NATRON_THIRD_PARTY_NO_WARNINGS
# and NATRON_BINDINGS_NO_WARNINGS in the CMake build (see CMakeLists.txt).
# Include this file at the end of a .pro file, after setting:
# - NATRON_THIRD_PARTY_SOURCES: bundled third-party C++ sources, compiled
#   without warnings;
# - NATRON_BINDINGS_SOURCES: the C++ sources generated by Shiboken, compiled
#   without the warnings they trigger by design (all other warnings stay on).
# qmake has no per-file compiler flags, so these files are compiled by extra
# compilers, the way Qt's own simd.prf does it.

msvc {
    natron_third_party_cxxflags = -W0
    natron_bindings_cxxflags =
} else {
    natron_third_party_cxxflags = -w
    natron_bindings_cxxflags = -Wno-cast-function-type -Wno-missing-field-initializers \
                               -Wno-unused-parameter -Wno-missing-declarations
}

natron_objects_dir = $$OBJECTS_DIR
!isEmpty(natron_objects_dir): natron_objects_dir = $$natron_objects_dir/

for(kind, $$list(third_party bindings)) {
    kind_sources = $$upper(NATRON_$${kind}_SOURCES)
    isEmpty($$kind_sources): next()
    kind_flags = $$eval(natron_$${kind}_cxxflags)
    isEmpty(kind_flags) {
        SOURCES += $$eval($$kind_sources)
        next()
    }
    natron_$${kind}.commands = $$QMAKE_CXX -c $(CXXFLAGS) $$kind_flags $(INCPATH) ${QMAKE_FILE_IN}
    msvc: natron_$${kind}.commands += -Fo${QMAKE_FILE_OUT}
    else: natron_$${kind}.commands += -o ${QMAKE_FILE_OUT}
    natron_$${kind}.dependency_type = TYPE_C
    natron_$${kind}.output = $${natron_objects_dir}${QMAKE_FILE_BASE}$${first(QMAKE_EXT_OBJ)}
    natron_$${kind}.input = $$kind_sources
    natron_$${kind}.variable_out = OBJECTS
    natron_$${kind}.name = compiling[$${kind}] ${QMAKE_FILE_IN}
    silent: natron_$${kind}.commands = @echo compiling ${QMAKE_FILE_IN} && $$eval(natron_$${kind}.commands)
    QMAKE_EXTRA_COMPILERS += natron_$${kind}
}

# Unlike the CMake build, the include directories of the bundled third-party
# code stay -I (INCLUDEPATH), not -isystem: -isystem directories are searched
# after every -I directory, and some SDK directories (-I/opt/local/include,
# -I/opt/Natron-sdk/include) only reach INCPATH after this file is read (e.g.
# from pkg-config), so an SDK with glog, gflags or gtest headers would replace the
# bundled headers while the bundled libraries are linked. Giving a directory both
# -I and -isystem doesn't help: GCC and clang then ignore the -I.
