+    do {
+      if( e->Org->s == SENTINEL_COORD || e->Org->s == -SENTINEL_COORD
+	  || e->Org->t == SENTINEL_COORD || e->Org->t == -SENTINEL_COORD ) {
+	longjmp(tess->env,TESS_JMP_DEGENERATE);
+      }
+      e = e->Lnext;
+    } while( e != f->anEdge );
