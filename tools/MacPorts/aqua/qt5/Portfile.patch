             # https://trac.macports.org/ticket/72729
             patchfiles-append patch-qtbase-tahoe-no-agl-framework.diff
 
+            # Natron: fix a lost wake-up in the non-futex QMutex on arm64 (NatronGitHub/Natron#1451):
