+# Natron: subport ffmpeg-lgpl, the FFmpeg of COMMERCIAL Natron builds (#1302): the same version
+# and configuration as "ffmpeg +gpl2 +highbitdepth +natronmini", without +gpl2 (no x264, x265, Xvid
+# or vid.stab) and without libzvbi, so LGPL-2.1+. It is installed in ${prefix}/libexec/ffmpeg-lgpl, with no links in
+# ${prefix}/bin, so that it can be installed next to ffmpeg. tools/jenkins/common.sh uses it when
+# NATRON_LICENSE=COMMERCIAL.
+subport ffmpeg-lgpl {
+    description     LGPL build of FFmpeg for Natron (no GPL or nonfree code)
+    # before the default +gpl2 below: the first default of a variant wins
+    default_variants-append \
