--- Portfile.orig	2026-11-17 22:49:35
+++ Portfile	2026-11-17 23:12:28
@@ -156,6 +156,63 @@
 # ImageMagick uses .la files at runtime to find its coder modules.
 destroot.delete_la_files    no
 
+# ImageMagick 7 for openfx-arena (Natron 2.6), as in Natron's Linux SDK and Windows
+# (tools/MINGW-packages/mingw-w64-imagemagick) builds: a static Q32 HDRI library
+# without modules, with OpenMP, and only the delegates openfx-arena uses: lcms2
+# (ICC profiles in ReadPSD), freetype and fontconfig (text), zlib, bzip2 and xz
+# (compressed layers), libpng. Installed in ${prefix}/lib/ImageMagick7, so it
+# doesn't conflict with ImageMagick (6) +natron, which other ports use.
+variant natron conflicts x11 openexr requires q32 hdri description {Natron version: static, OpenMP, for openfx-arena} {
+    # libc++-based build
+    # compiler with proper OpenMP support (GCC >= 4.8, clang >= 4.0)
+    compiler.blacklist-append {*gcc-3*} {*gcc-4.[0-1]} {macports-gcc-4.[2-8]} {gcc-4.[2-8]} {apple-gcc-4.[2-8]} cc clang {macports-clang < 400}
+
+    configure.args-replace  --disable-openmp --enable-openmp
+    configure.args-replace  --enable-shared --disable-shared
+    configure.args-replace  --with-modules --without-modules
+    # the configuration files are built into the library: the bundled plug-in
+    # doesn't read them from ${prefix}. The --with-frozenpaths and
+    # --with-gs-font-dir (urw-fonts) of the main configure.args are harmless with
+    # it: they only name the delegate programs and the Ghostscript fonts, which
+    # openfx-arena doesn't use.
+    configure.args-append   --enable-zero-configuration
+    configure.args-replace  --enable-opencl --disable-opencl
+    depends_lib-delete      port:djvulibre port:jbigkit path:include/turbojpeg.h:libjpeg-turbo \
+                            port:libjxl port:libraw port:tiff port:webp port:fftw-3 \
+                            port:ghostscript port:openjpeg port:libxml2 port:libheif port:libtool
+    configure.args-replace  --with-dps --without-dps
+    configure.args-replace  --with-djvu --without-djvu
+    configure.args-replace  --with-fftw --without-fftw
+    configure.args-replace  --with-gslib --without-gslib
+    configure.args-replace  --with-jbig --without-jbig
+    configure.args-replace  --with-jpeg --without-jpeg
+    configure.args-replace  --with-openjp2 --without-openjp2
+    configure.args-replace  --with-tiff --without-tiff
+    configure.args-replace  --with-webp --without-webp
+    configure.args-replace  --with-xml --without-xml
+    configure.args-replace  --with-heic --without-heic
+    configure.args-append   --without-jxl --without-raw --without-uhdr --without-dmr
+    # the delegate programs of delegates.xml, which openfx-arena doesn't use
+    depends_run-delete      port:jxrlib port:libbpg port:urw-fonts port:xdg-utils
+
+    post-destroot {
+        if {${configure.cxx_stdlib} eq "libc++"} {
+            # The pkg-config files contain -lgomp instead of -L/opt/local/lib/libomp -lomp
+            foreach f [glob -directory ${destroot}${prefix}/lib/ImageMagick7/lib/pkgconfig Magick*pc ImageMagick*pc] {
+                reinplace -locale C "/Libs.private: /s:-lgomp:-L${prefix}/lib/libomp -lomp:g" ${f}
+            }
+        }
+    }
+}
+
+variant q32 description {Use Q32 quantum depth} {
+    configure.args-append   --with-quantum-depth=32
+}
+
+variant hdri description {High Dynamic Range Imagery} {
+    configure.args-replace  --disable-hdri --enable-hdri
+}
+
 variant graphviz description {Support Graphviz} {
     depends_lib-append      path:bin/dot:graphviz
     configure.args-replace  --without-gvc --with-gvc
