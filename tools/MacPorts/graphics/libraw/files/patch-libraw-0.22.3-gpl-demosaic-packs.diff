+1. GNU LESSER GENERAL PUBLIC LICENSE version 2.1
+   (See file LICENSE.LGPL provided in LibRaw distribution archive for details).
+
+2. COMMON DEVELOPMENT AND DISTRIBUTION LICENSE (CDDL) Version 1.0
+   (See file LICENSE.CDDL provided in LibRaw distribution archive for details).
+
+ */
+
+/*
+   Glue for the (unmodified) LibRaw-demosaic-pack-GPL2/GPL3 0.18.8 sources.
+
+   This file contains no GPL code. The pack sources are only compiled in when
+   LIBRAW_DEMOSAIC_PACK_GPL2 / LIBRAW_DEMOSAIC_PACK_GPL3 are defined and the
+   pack directories are on the include path (see configure.ac
+   --enable-demosaic-pack-gpl2[=DIR] / --enable-demosaic-pack-gpl3[=DIR]).
+   A library built that way is covered by the GPL (v2+ or v3+ respectively).
+   Without these defines this file compiles to nothing.
+ */
+
+#if defined(LIBRAW_DEMOSAIC_PACK_GPL2) || defined(LIBRAW_DEMOSAIC_PACK_GPL3)
+
+#include "../../internal/dcraw_defs.h"
+
+#ifndef CLASS
+#define CLASS LibRaw::
+#endif
+
+/* Compatibility with the 0.18 internal API used by the pack sources */
+/* merror(): LibRaw::malloc/calloc now throw on failure; keep a NULL check */
+#define merror(ptr, where)                                                     \
+  do                                                                           \
+  {                                                                            \
+    if (!(ptr))                                                                \
+      throw LIBRAW_EXCEPTION_ALLOC;                                            \
+  } while (0)
+/* color constants moved to LibRaw_constants */
+#define xyz_rgb LibRaw_constants::xyz_rgb
+#define d65_white LibRaw_constants::d65_white
+
+#ifdef LIBRAW_DEMOSAIC_PACK_GPL2
+#include <ahd_interpolate_mod.c>
+#include <ahd_partial_interpolate.c>
+#include <afd_interpolate_pl.c>
+#include <vcd_interpolate.c>
+#include <lmmse_interpolate.c>
+#include <median_filter_new.c>
+#endif
+
+#ifdef LIBRAW_DEMOSAIC_PACK_GPL3
+/* amaze_demosaic_RT.cc defines its own versions of these */
+#undef SQR
+#undef LIM
+#undef ULIM
+#include <amaze_demosaic_RT.cc>
+#endif
+
+#endif
