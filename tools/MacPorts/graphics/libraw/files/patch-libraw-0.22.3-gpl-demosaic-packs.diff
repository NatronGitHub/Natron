   return ret;
 }
 
diff -ruN LibRaw-0.22.3/tests/demosaic_test.cpp b/LibRaw-0.22.3/tests/demosaic_test.cpp
--- tests/demosaic_test.cpp	1970-01-01 01:00:00
+++ tests/demosaic_test.cpp	2026-11-14 20:16:11
@@ -0,0 +1,281 @@
+/* -*- C++ -*-
+ * Copyright 2026 LibRaw LLC (info@libraw.org)
+ *
+ LibRaw is free software; you can redistribute it and/or modify
+ it under the terms of the one of two licenses as you choose:
+
+1. GNU LESSER GENERAL PUBLIC LICENSE version 2.1
+   (See file LICENSE.LGPL provided in LibRaw distribution archive for details).
+
+2. COMMON DEVELOPMENT AND DISTRIBUTION LICENSE (CDDL) Version 1.0
+   (See file LICENSE.CDDL provided in LibRaw distribution archive for details).
+
+ */
+
+/*
+   Demosaic regression test (run by "make check").
+
+   A synthetic RGB image is mosaiced into a 16-bit RGGB Bayer buffer, opened
+   with LibRaw::open_bayer() and processed with every user_qual value
+   (0-12). For each algorithm the test checks that:
+   - dcraw_process() succeeds;
+   - LIBRAW_WARN_FALLBACK_TO_AHD is set exactly when the algorithm is not
+     available (user_qual 5-9 need demosaic pack GPL2, 10 needs GPL3);
+   - LibRaw::capabilities() reports LIBRAW_CAPS_DEMOSAICSGPL2/3 exactly when
+     the library was built with the corresponding pack;
+   - the result is close to the original RGB image (PSNR above a threshold);
+   - an available non-AHD algorithm does not produce the AHD result.
+
+   The expected pack availability comes from the LIBRAW_DEMOSAIC_PACK_GPL2/3
+   macros, which configure adds to CPPFLAGS for both the library and this
+   test. Pass --print to see the per-algorithm PSNR values.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vector>
+
+#include "libraw/libraw.h"
+
+namespace
+{
+
+const int W = 300; // not a multiple of the AMaZE tile size (512), on purpose
+const int H = 220;
+const int BORDER = 16; // pixels ignored near the image border
+const double MAXV = 4000.0;
+
+// Smooth gradients, a sharp diagonal edge and colored disks: enough structure
+// to tell demosaic algorithms apart, but free of fine aliasing patterns so that
+// all algorithms are expected to do reasonably well.
+void reference(int x, int y, double rgb[3])
+{
+  double fx = x / (double)W, fy = y / (double)H;
+  rgb[0] = 0.15 + 0.6 * fx;
+  rgb[1] = 0.20 + 0.5 * fy;
+  rgb[2] = 0.15 + 0.3 * (1 - fx) + 0.2 * fy;
+  if (x + 0.6 * y > 0.7 * W) // sharp edge
+  {
+    rgb[0] *= 0.5;
+    rgb[1] *= 0.6;
+    rgb[2] = rgb[2] * 0.5 + 0.3;
+  }
+  double dx = x - 0.3 * W, dy = y - 0.6 * H;
+  if (dx * dx + dy * dy < 30 * 30)
+  {
+    rgb[0] = 0.8;
+    rgb[1] = 0.25;
+    rgb[2] = 0.2;
+  }
+  dx = x - 0.75 * W;
+  dy = y - 0.3 * H;
+  if (dx * dx + dy * dy < 25 * 25)
+  {
+    rgb[0] = 0.2;
+    rgb[1] = 0.3;
+    rgb[2] = 0.85;
+  }
+  for (int c = 0; c < 3; c++)
+    rgb[c] *= MAXV;
+}
+
+struct Algo
+{
+  int qual;
+  const char *name;
+  int pack;        // 0: always available, 2: GPL2 pack, 3: GPL3 pack
+  double min_psnr; // dB, on the interior of the image
+};
+
+const Algo algos[] = {
+    {0, "linear", 0, 25.}, {1, "VNG", 0, 28.},      {2, "PPG", 0, 28.},
+    {3, "AHD", 0, 28.},    {4, "DCB", 0, 28.},      {5, "AHD-Mod", 2, 28.},
+    {6, "AFD", 2, 28.},    {7, "VCD", 2, 28.},      {8, "VCD+AHD", 2, 28.},
+    {9, "LMMSE", 2, 28.},  {10, "AMaZE", 3, 28.},   {11, "DHT", 0, 28.},
+    {12, "AAHD", 0, 28.},
+};
+
+#ifdef LIBRAW_DEMOSAIC_PACK_GPL2
+const bool have_gpl2 = true;
+#else
+const bool have_gpl2 = false;
+#endif
+#ifdef LIBRAW_DEMOSAIC_PACK_GPL3
+const bool have_gpl3 = true;
+#else
+const bool have_gpl3 = false;
+#endif
+
+bool available(const Algo &a)
+{
+  return a.pack == 0 || (a.pack == 2 && have_gpl2) ||
+         (a.pack == 3 && have_gpl3);
+}
+
+// Runs one demosaic. On success, out receives W*H*3 linear values.
+bool run(const std::vector<unsigned char> &bayer, int qual,
+         std::vector<double> &out, unsigned &warnings)
+{
+  LibRaw *lr = new LibRaw;
+  int ret = lr->open_bayer(&bayer[0], (unsigned)bayer.size(), W, H, 0, 0, 0, 0,
+                           0, LIBRAW_OPENBAYER_RGGB, 0, 0, 0);
+  if (ret == LIBRAW_SUCCESS)
+    ret = lr->unpack();
+  if (ret == LIBRAW_SUCCESS)
+  {
+    libraw_output_params_t &O = lr->imgdata.params;
+    O.user_qual = qual;
+    O.output_color = 0; // raw color: no color matrix
+    O.no_auto_bright = 1;
+    O.gamm[0] = O.gamm[1] = 1.0;
+    O.output_bps = 16;
+    O.highlight = 0;
+    O.med_passes = 0;
+    O.use_camera_wb = O.use_auto_wb = 0;
+    O.user_black = 0;
+    ret = lr->dcraw_process();
+  }
+  if (ret != LIBRAW_SUCCESS)
+  {
+    fprintf(stderr, "user_qual %d: LibRaw error %d (%s)\n", qual, ret,
+            libraw_strerror(ret));
+    delete lr;
+    return false;
+  }
+  warnings = lr->imgdata.process_warnings;
+  if (lr->imgdata.sizes.iwidth != W || lr->imgdata.sizes.iheight != H)
+  {
+    fprintf(stderr, "user_qual %d: unexpected output size %dx%d\n", qual,
+            lr->imgdata.sizes.iwidth, lr->imgdata.sizes.iheight);
+    delete lr;
+    return false;
+  }
+  out.resize(W * H * 3);
+  for (int i = 0; i < W * H; i++)
+    for (int c = 0; c < 3; c++)
+      out[i * 3 + c] = lr->imgdata.image[i][c];
+  delete lr;
+  return true;
+}
+
+// PSNR on the interior, after fitting one gain per channel (scale_colors()
+// may rescale the data slightly).
+double psnr(const std::vector<double> &out, const std::vector<double> &ref)
+{
+  double sse = 0;
+  long n = 0;
+  for (int c = 0; c < 3; c++)
+  {
+    double so = 0, sr = 0;
+    for (int y = BORDER; y < H - BORDER; y++)
+      for (int x = BORDER; x < W - BORDER; x++)
+      {
+        int i = (y * W + x) * 3 + c;
+        so += out[i] * ref[i];
+        sr += out[i] * out[i];
+      }
+    double g = sr > 0 ? so / sr : 0;
+    for (int y = BORDER; y < H - BORDER; y++)
+      for (int x = BORDER; x < W - BORDER; x++)
+      {
+        int i = (y * W + x) * 3 + c;
+        double d = g * out[i] - ref[i];
+        sse += d * d;
+        n++;
+      }
+  }
+  double mse = sse / n;
+  return mse > 0 ? 10 * log10(MAXV * MAXV / mse) : 999.;
+}
+
+} // namespace
+
+int main(int argc, char **argv)
+{
+  bool print = argc > 1 && !strcmp(argv[1], "--print");
+  int failures = 0;
+
+  printf("%s, demosaic pack GPL2: %s, GPL3: %s\n", LibRaw::version(),
+         have_gpl2 ? "yes" : "no", have_gpl3 ? "yes" : "no");
+
+  unsigned caps = LibRaw::capabilities();
+  if (!!(caps & LIBRAW_CAPS_DEMOSAICSGPL2) != have_gpl2 ||
+      !!(caps & LIBRAW_CAPS_DEMOSAICSGPL3) != have_gpl3)
+  {
+    fprintf(stderr, "FAIL: capabilities() = 0x%x does not match the build\n",
+            caps);
+    failures++;
+  }
+
+  std::vector<double> ref(W * H * 3);
+  std::vector<unsigned char> bayer(W * H * 2);
+  for (int y = 0; y < H; y++)
+    for (int x = 0; x < W; x++)
+    {
+      double rgb[3];
+      reference(x, y, rgb);
+      for (int c = 0; c < 3; c++)
+        ref[(y * W + x) * 3 + c] = rgb[c];
+      int c = (y & 1) ? ((x & 1) ? 2 : 1) : ((x & 1) ? 1 : 0); // RGGB
+      unsigned v = (unsigned)(rgb[c] + 0.5);
+      bayer[(y * W + x) * 2] = v & 0xff; // little endian
+      bayer[(y * W + x) * 2 + 1] = v >> 8;
+    }
+
+  std::vector<double> ahd;
+  unsigned w;
+  if (!run(bayer, 3, ahd, w))
+    return 1;
+
+  for (size_t k = 0; k < sizeof(algos) / sizeof(algos[0]); k++)
+  {
+    const Algo &a = algos[k];
+    std::vector<double> out;
+    unsigned warnings = 0;
+    if (!run(bayer, a.qual, out, warnings))
+    {
+      failures++;
+      continue;
+    }
+    bool avail = available(a);
+    bool fellback = (warnings & LIBRAW_WARN_FALLBACK_TO_AHD) != 0;
+    double p = psnr(out, ref);
+    bool same_as_ahd = out == ahd;
+    bool ok = true;
+    if (fellback == avail)
+    {
+      fprintf(stderr, "FAIL: %s (user_qual %d): fallback to AHD %s\n", a.name,
+              a.qual, fellback ? "unexpected" : "missing");
+      ok = false;
+    }
+    if (p < a.min_psnr)
+    {
+      fprintf(stderr, "FAIL: %s (user_qual %d): PSNR %.2f dB < %.2f dB\n",
+              a.name, a.qual, p, a.min_psnr);
+      ok = false;
+    }
+    if (avail && a.qual != 3 && same_as_ahd)
+    {
+      fprintf(stderr, "FAIL: %s (user_qual %d): result identical to AHD\n",
+              a.name, a.qual);
+      ok = false;
+    }
+    if (!avail && !same_as_ahd)
+    {
+      fprintf(stderr, "FAIL: %s (user_qual %d): fallback differs from AHD\n",
+              a.name, a.qual);
+      ok = false;
+    }
+    if (print || !ok)
+      printf("%-8s user_qual %2d: %s, PSNR %6.2f dB%s\n", a.name, a.qual,
+             avail ? "available  " : "unavailable", p,
+             fellback ? " (AHD fallback)" : "");
+    if (!ok)
+      failures++;
+  }
+
+  printf("%s\n", failures ? "FAILED" : "PASSED");
+  return failures ? 1 : 0;
+}
