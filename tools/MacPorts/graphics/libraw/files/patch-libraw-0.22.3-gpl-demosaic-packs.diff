diff -ruN LibRaw-0.22.3/configure.ac b/LibRaw-0.22.3/configure.ac
--- configure.ac	2026-10-24 11:24:46
+++ configure.ac	2026-11-14 20:16:11
@@ -116,6 +116,35 @@
 	esac],[examples=true])
 AM_CONDITIONAL([EXAMPLES], [test x$examples = xtrue])
 
+# LibRaw-demosaic-pack-GPL2 / LibRaw-demosaic-pack-GPL3 (0.18.8 sources)
+# Disabled by default. --enable-demosaic-pack-gplN looks for the pack in
+# $srcdir/LibRaw-demosaic-pack-GPLN, --enable-demosaic-pack-gplN=DIR uses DIR.
+# Enabling a pack makes the resulting library GPL (v2+ for GPL2, v3+ for GPL3).
+AC_DEFUN([LIBRAW_DEMOSAIC_PACK],[
+AC_ARG_ENABLE([demosaic-pack-gpl$1],
+	AS_HELP_STRING([--enable-demosaic-pack-gpl$1@<:@=DIR@:>@],
+		[Enable LibRaw demosaic pack/GPL$1 (from DIR, default $srcdir/LibRaw-demosaic-pack-GPL$1); the library becomes GPL$1+]),
+	[case "${enableval}" in
+		yes)	dp$1=true; dp$1dir="${srcdir}/LibRaw-demosaic-pack-GPL$1" ;;
+		no)	dp$1=false ;;
+		*)	dp$1=true; dp$1dir="${enableval}" ;;
+	esac],[dp$1=false])
+if test x$dp$1 = xtrue ; then
+	if test -f "${dp$1dir}/$2" ; then
+		dp$1dir=`cd "${dp$1dir}" && pwd`
+		AC_MSG_NOTICE([Activated LibRaw demosaic pack/GPL$1 in ${dp$1dir}])
+		CPPFLAGS="$CPPFLAGS -DLIBRAW_DEMOSAIC_PACK_GPL$1"
+		LIBRAW_DEMOSAIC_PACKS_CPPFLAGS="$LIBRAW_DEMOSAIC_PACKS_CPPFLAGS -I${dp$1dir}"
+	else
+		AC_MSG_ERROR([${dp$1dir} does not contain LibRaw-demosaic-pack-GPL$1 ($2 not found)])
+	fi
+fi
+])
+LIBRAW_DEMOSAIC_PACKS_CPPFLAGS=
+LIBRAW_DEMOSAIC_PACK([2],[afd_interpolate_pl.c])
+LIBRAW_DEMOSAIC_PACK([3],[amaze_demosaic_RT.cc])
+AC_SUBST([LIBRAW_DEMOSAIC_PACKS_CPPFLAGS])
+
 LIBS="$LIBS -lm"
 
