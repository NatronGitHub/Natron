@@ -3,13 +3,12 @@
 PortSystem          1.0
 
 name                libraw
-version             0.22.2
+# Natron: 0.22.3 with the GPL demosaic packs restored (patch-libraw-0.22.3-gpl-demosaic-packs.diff,
+# variants gpl2/gpl3). Keep this Portfile when reintegrating upstream (only Portfile.orig follows upstream).
+version             0.22.3
 revision            0
+set demosaicversion 0.18.8
 
-checksums           rmd160  67d0d08c93eca06d84b401d8ab1698e8b36f2abf \
-                    sha256  de86b035655accff8d4010f1a221fdf50d353cb7b1422ba26f14a0db92612cfa \
-                    size    1682962
-
 description         Library for RAW image manipulation
 long_description    A library for reading RAW files obtained from digital photo \
                     cameras (CRW/CR2, NEF, RAF, DNG, and others).
@@ -23,12 +22,44 @@
 master_sites        ${homepage}/data/
 distname            LibRaw-${version}
 
+checksums \
+    LibRaw-${version}${extract.suffix} \
+        rmd160  879e786e8aaab140d88e6eb3eb167fd1dacb4764 \
+        sha256  789f3c33466210a1a0907f747a97c715d21bbf4af712f257fcbbd90111b227e4 \
+        size    1689119 \
+    LibRaw-demosaic-pack-GPL2-${demosaicversion}${extract.suffix} \
+        rmd160  b86ee8d0e790b2976f90ac7adecf8df4a3d92cd4 \
+        sha256  0b24bcf7bbb5d13fde58bb071f94dc9354be09bc44b2bba0698493065e99f8da \
+        size    30868 \
+    LibRaw-demosaic-pack-GPL3-${demosaicversion}${extract.suffix} \
+        rmd160  a83d4886ea3455425ec305160c04baf7a617db60 \
+        sha256  ffd6916cd66c8101e4e6b589799f256c897748d2fd2486aa34c3705146dbc701 \
+        size    39002
+
+# Natron: subport libraw-lgpl, the LibRaw of COMMERCIAL Natron builds (#1302): the same LibRaw
+# without any demosaic pack (LGPL-2.1/CDDL), installed in ${prefix}/libexec/libraw-lgpl so that it
+# can be installed next to "libraw +gpl2". tools/jenkins/common.sh uses it when NATRON_LICENSE=COMMERCIAL.
+subport libraw-lgpl {
+    description     LibRaw without the GPL demosaic packs, for Natron's COMMERCIAL builds
+    configure.pre_args-delete --prefix=${prefix}
+    configure.pre_args-append --prefix=${prefix}/libexec/${subport}
+    pre-configure {
+        if {[variant_isset gpl2] || [variant_isset gpl3]} {
+            return -code error "${subport} is the LGPL LibRaw of Natron's COMMERCIAL builds: install it without +gpl2 or +gpl3"
+        }
+    }
+}
+
 depends_build       port:pkgconfig
 
 depends_lib         port:jasper \
                     path:include/turbojpeg.h:libjpeg-turbo \
                     port:lcms2
 
+# Natron: restore the GPL demosaic packs (AHD-Mod, AFD, VCD, Mixed, LMMSE; AMaZE with GPL3);
+# it changes configure.ac and Makefile.am, hence the autoreconf below
+patchfiles          patch-libraw-0.22.3-gpl-demosaic-packs.diff
+
 use_autoreconf      yes
 autoreconf.args     -fvi
 
@@ -43,11 +74,42 @@
 patchfiles-append   patch-libraw-no-libstdcxx.diff
 
 post-destroot {
-    set htmlDir ${destroot}${prefix}/share/doc/${name}/html
+    if {${subport} eq "libraw-lgpl"} {
+        set htmlDir ${destroot}${prefix}/libexec/${subport}/share/doc/libraw/html
+    } else {
+        set htmlDir ${destroot}${prefix}/share/doc/${name}/html
+    }
     xinstall -d -m 0755 ${htmlDir}
     xinstall -m 644 {*}[glob -directory ${worksrcpath}/doc/ *.html] ${htmlDir}
 }
 
+# tests/demosaic_test checks which demosaic packs are active: run it on every build
+test.run            yes
+test.target         check
+post-build {
+    system -W ${worksrcpath} "${build.cmd} check"
+    if {${subport} eq "libraw-lgpl"} {
+        # no demosaic pack: LGPL
+        system -W ${worksrcpath} "grep -q 'GPL2: no, GPL3: no' tests/demosaic_test.log"
+    }
+}
+
+variant gpl2 description {Enable the GPL2 demosaic pack (AHD-Mod, AFD, VCD, Mixed, LMMSE), license will be GPL-2+} {
+    distfiles-append \
+        LibRaw-demosaic-pack-GPL2-${demosaicversion}${extract.suffix}
+    configure.args-append \
+        --enable-demosaic-pack-gpl2=${workpath}/LibRaw-demosaic-pack-GPL2-${demosaicversion}
+    license                 GPL-2+
+}
+
+variant gpl3 requires gpl2 description {Also enable the GPL3 demosaic pack (AMaZE), license will be GPL-3+} {
+    distfiles-append \
+        LibRaw-demosaic-pack-GPL3-${demosaicversion}${extract.suffix}
+    configure.args-append \
+        --enable-demosaic-pack-gpl3=${workpath}/LibRaw-demosaic-pack-GPL3-${demosaicversion}
+    license                 GPL-3+
+}
+
 livecheck.type      regex
 livecheck.url       ${homepage}/download/
 livecheck.regex     "LibRaw-(\\d+(?:\\.\\d+)*)${extract.suffix}"
