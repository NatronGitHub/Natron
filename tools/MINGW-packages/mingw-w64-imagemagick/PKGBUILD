#
# ImageMagick 6/7 for openfx-arena <https://github.com/NatronGitHub/openfx-arena>
#

# freetype/fontconfig is needed to support Text5 and Polaroid
# bzip2/xz/zlib is needed to support compressions in ReadPSD
# lcms2 is needed for color support in ReadPSD
# libpng should be added for legacy support

# ImageMagick 6 (openfx-arena doesn't support ImageMagick 7), the same version
# as the MacPorts overlay (tools/MacPorts/graphics/ImageMagick).
_basever=6.9.13-59
pkgver=${_basever//-/.}

_realname=imagemagick
pkgbase="mingw-w64-natron_${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-natron_${_realname}"
pkgrel=1
pkgdesc="An image viewing/manipulation program, version 6, for openfx-arena (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64')
url="https://www.imagemagick.org/"
license=("custom")
makedepends=("${MINGW_PACKAGE_PREFIX}-autotools"
             "${MINGW_PACKAGE_PREFIX}-cc")
depends=(
         "${MINGW_PACKAGE_PREFIX}-libpng"
         "${MINGW_PACKAGE_PREFIX}-bzip2"
         "${MINGW_PACKAGE_PREFIX}-xz"
         "${MINGW_PACKAGE_PREFIX}-zlib"
         "${MINGW_PACKAGE_PREFIX}-freetype"
         "${MINGW_PACKAGE_PREFIX}-fontconfig"
         "${MINGW_PACKAGE_PREFIX}-lcms2"
         "${MINGW_PACKAGE_PREFIX}-gcc-libs"  # libgomp (OpenMP)
        )
options=('strip' '!debug' 'libtool')

source=(
        "ImageMagick6-${_basever}.tar.gz::https://github.com/ImageMagick/ImageMagick6/archive/refs/tags/${_basever}.tar.gz"
        ImageMagick-6-mingw.patch
        fix-compiler-errors.patch
       )
sha256sums=(
            '867f2194939459047475475f7c15413e46c529acb57f779080298901508cc4e3'
            '026d8ae551b643ded51f560b3f5db8829854c3ea235f45993da06ba3245219e4'
            'a50a9562a34f5d8741869ccec1d62f8b55cb2440c574ba0749d8c0e66c724862'
           )

prepare() {
  cd ImageMagick6-${_basever}

  # don't depend on ltdl
  sed -i 's#with_ltdl='\''yes'\''#with_ltdl='\''no'\''#g' configure.ac

  # mingw fixes
  patch -p1 -i ${srcdir}/ImageMagick-6-mingw.patch
  patch -p1 -i ${srcdir}/fix-compiler-errors.patch
  # (the XCF coder reads GIMP 2.10 files since 6.9.12-76: no gimp210 patch)

  # fix linker
  sed -i 's#$(MAGICK_DEP_LIBS)#$(MAGICK_DEP_LIBS) -lws2_32#g' magick/Makefile.am

  # update configure
  autoreconf -fi
}

build() {
  export lt_cv_deplibs_check_method='pass_all'
  [[ $CARCH = "i686" ]] && EXTRAOPTS="--with-gcc-arch=i686"
  [[ $CARCH = "x86_64" ]] && EXTRAOPTS="" #EXTRAOPTS="--with-gcc-arch=x86-64"

  [[ -d build-${MINGW_CHOST} ]] && rm -rf build-${MINGW_CHOST}
  
  mkdir -p build-${MINGW_CHOST} && cd build-${MINGW_CHOST}
  ../ImageMagick6-${_basever}/configure \
    --prefix=${MINGW_PREFIX} \
    --build=${MINGW_CHOST} \
    --host=${MINGW_CHOST} \
    --with-windows-font-dir=c:/Windows/fonts \
    --with-magick-plus-plus=yes \
    --with-quantum-depth=32 \
    --with-lcms \
    --with-lzma \
    --with-zlib \
    --with-bzlib \
    --with-png \
    --with-freetype \
    --with-fontconfig \
    --without-heic \
    --without-raqm \
    --without-raw \
    --without-zstd \
    --without-dps \
    --without-djvu \
    --without-fftw \
    --without-fpx \
    --without-gslib \
    --without-gvc \
    --without-jbig \
    --without-jpeg \
    --without-openjp2 \
    --without-lqr \
    --without-openexr \
    --without-pango \
    --without-rsvg \
    --without-tiff \
    --without-webp \
    --without-xml \
    --without-x \
    --without-modules \
    --without-wmf \
    --without-autotrace \
    --without-fpx \
    --without-jbig \
    --without-perl \
    --enable-hdri \
    --enable-zero-configuration \
    --enable-static \
    --disable-opencl \
    --disable-shared \
    --disable-deprecated \
    --disable-legacy-support \
    --disable-docs \
    $EXTRAOPTS \
    CFLAGS="${CFLAGS}" CPPFLAGS="${CPPFLAGS}" LDFLAGS="${LDFLAGS} -lws2_32"

  make 

}

package() {
  cd ${srcdir}/build-${MINGW_CHOST}
  make -j1 DESTDIR="${pkgdir}" install 

  install -Dm644 ${srcdir}/ImageMagick6-${_basever}/LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 ${srcdir}/ImageMagick6-${_basever}/NOTICE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/NOTICE"

  local PREFIX_WIN=$(cygpath -wm ${MINGW_PREFIX})
  # fix hard-coded pathes in .pc files
  for _f in "${pkgdir}${MINGW_PREFIX}"\/lib\/pkgconfig\/*.pc; do
    sed -e "s|${PREFIX_WIN}|${MINGW_PREFIX}|g" -i ${_f}
  done
}
