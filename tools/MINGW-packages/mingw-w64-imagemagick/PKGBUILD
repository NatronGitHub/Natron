#
# ImageMagick 7 for openfx-arena <https://github.com/NatronGitHub/openfx-arena>
#
# A static, Q32 HDRI build, without modules, with Magick++ and OpenMP (libgomp
# on UCRT64, LLVM's libomp on CLANGARM64), and only the coders and delegates openfx-arena uses: PSD, XCF
# (GIMP 2.10 files), BMP, XPM, MIFF, PCX and the built-in pseudo-formats
# (plasma:, pattern:, gradient:, radial-gradient:), which need no delegate.
# - lcms2 for the ICC profiles in ReadPSD
# - freetype and fontconfig for the Text plug-ins (fonts by family name)
# - zlib, bzip2 and xz for the compressed layers in ReadPSD
# - libpng for the PNG-based formats
# MSYS2's own imagemagick is a Q16, shared, modules build, which openfx-arena
# can't link statically.

_basever=7.1.2-36
pkgver=${_basever//-/.}

_realname=imagemagick
pkgbase="mingw-w64-natron_${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-natron_${_realname}"
pkgrel=2
pkgdesc="An image viewing/manipulation program, static Q32 HDRI build for openfx-arena (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clangarm64')
url="https://www.imagemagick.org/"
license=("spdx:ImageMagick")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc")
depends=(
         "${MINGW_PACKAGE_PREFIX}-libpng"
         "${MINGW_PACKAGE_PREFIX}-bzip2"
         "${MINGW_PACKAGE_PREFIX}-xz"
         "${MINGW_PACKAGE_PREFIX}-zlib"
         "${MINGW_PACKAGE_PREFIX}-freetype"
         "${MINGW_PACKAGE_PREFIX}-fontconfig"
         "${MINGW_PACKAGE_PREFIX}-lcms2"
         "${MINGW_PACKAGE_PREFIX}-omp"  # OpenMP: libgomp (UCRT64) or llvm-openmp (CLANGARM64)
        )
conflicts=("${MINGW_PACKAGE_PREFIX}-${_realname}")
options=('strip' '!debug' 'libtool' 'staticlibs')

source=("https://github.com/ImageMagick/ImageMagick/releases/download/${_basever}/ImageMagick-${_basever}.tar.xz")
sha256sums=('410cab5ed416329290e77cbd7833a76502671ea25a42d1cfe010f9067b27c2d6')

build() {
  export lt_cv_deplibs_check_method='pass_all'

  [[ -d build-${MINGW_CHOST} ]] && rm -rf build-${MINGW_CHOST}
  mkdir -p build-${MINGW_CHOST} && cd build-${MINGW_CHOST}

  # No modules and no OpenCL, so no libltdl.
  ../ImageMagick-${_basever}/configure \
    --prefix=${MINGW_PREFIX} \
    --build=${MINGW_CHOST} \
    --host=${MINGW_CHOST} \
    --with-windows-font-dir=c:/Windows/fonts \
    --with-magick-plus-plus=yes \
    --with-quantum-depth=32 \
    --enable-hdri \
    --enable-openmp \
    --enable-zero-configuration \
    --enable-static \
    --disable-shared \
    --without-modules \
    --disable-opencl \
    --disable-deprecated \
    --disable-docs \
    --with-lcms \
    --with-freetype \
    --with-fontconfig \
    --with-zlib \
    --with-bzlib \
    --with-lzma \
    --with-png \
    --without-autotrace \
    --without-djvu \
    --without-dmr \
    --without-dps \
    --without-fftw \
    --without-flif \
    --without-fpx \
    --without-gslib \
    --without-gvc \
    --without-heic \
    --without-jbig \
    --without-jpeg \
    --without-jxl \
    --without-lqr \
    --without-openexr \
    --without-openjp2 \
    --without-pango \
    --without-perl \
    --without-raqm \
    --without-raw \
    --without-rsvg \
    --without-tiff \
    --without-uhdr \
    --without-webp \
    --without-wmf \
    --without-x \
    --without-xml \
    --without-zip \
    --without-zstd \
    CFLAGS="${CFLAGS}" CPPFLAGS="${CPPFLAGS}" LDFLAGS="${LDFLAGS}"

  make
}

package() {
  cd ${srcdir}/build-${MINGW_CHOST}
  make -j1 DESTDIR="${pkgdir}" install

  install -Dm644 ${srcdir}/ImageMagick-${_basever}/LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 ${srcdir}/ImageMagick-${_basever}/NOTICE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/NOTICE"

  local PREFIX_WIN=$(cygpath -wm ${MINGW_PREFIX})
  # fix hard-coded paths in the .pc files
  for _f in "${pkgdir}${MINGW_PREFIX}"/lib/pkgconfig/*.pc; do
    sed -e "s|${PREFIX_WIN}|${MINGW_PREFIX}|g" -i ${_f}
  done
}
