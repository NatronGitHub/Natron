  "${MINGW_PACKAGE_PREFIX}-fontconfig"
  "${MINGW_PACKAGE_PREFIX}-pango"
  "${MINGW_PACKAGE_PREFIX}-librsvg"
  "${MINGW_PACKAGE_PREFIX}-libxml2"
  # openfx-gmic
  "${MINGW_PACKAGE_PREFIX}-curl"
  "${MINGW_PACKAGE_PREFIX}-fftw"
  # installer (no crash reporter until #1183: no breakpad, no dump_syms)
  "zip"
  "unzip"
  "${MINGW_PACKAGE_PREFIX}-firebird"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-python-sphinx"
  "${MINGW_PACKAGE_PREFIX}-python-sphinx_rtd_theme"
  "${MINGW_PACKAGE_PREFIX}-natron-setup"
  "${MINGW_PACKAGE_PREFIX}-ntldd"   # DLL dependency lists for bundling
  # No qt-installer-framework: the Windows installer is Inno Setup (natron-setup),
