# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=LibRaw
pkgbase=mingw-w64-natron_libraw-gpl2
pkgname="${MINGW_PACKAGE_PREFIX}-natron_libraw-gpl2"
provides=("${MINGW_PACKAGE_PREFIX}-natron_${_realname}-gpl2")
replaces=("${MINGW_PACKAGE_PREFIX}-natron_${_realname}-gpl2")
conflicts=("${MINGW_PACKAGE_PREFIX}-natron_${_realname}-gpl2" "${MINGW_PACKAGE_PREFIX}-${_realname}-gpl2")
pkgver=0.22.3
pkgrel=1
pkgdesc="Library for reading RAW files obtained from digital photo cameras (mingw-w64)"
arch=('any')
url="https://www.libraw.org/"
license=("GPL2")   # LGPL + CDDL, but GPL-2+ with the GPL2 demosaic pack
makedepends=("${MINGW_PACKAGE_PREFIX}-gcc"
             "${MINGW_PACKAGE_PREFIX}-pkg-config"
             "${MINGW_PACKAGE_PREFIX}-autotools")
depends=("${MINGW_PACKAGE_PREFIX}-gcc-libs"
         "${MINGW_PACKAGE_PREFIX}-lcms2"
         "${MINGW_PACKAGE_PREFIX}-jasper")
options=('staticlibs' 'strip')
# LibRaw 0.19+ dropped the GPL demosaic packs: patch-libraw-0.22.3-gpl-demosaic-packs.diff restores them
# (from https://github.com/devernay/LibRaw/commit/56970694). Only the GPL2 pack is built (no GPL3 in Natron).
# The old LibRaw_force-openmp/obsolete-macros/wsock32 patches are no longer needed with 0.22.3.
source=("https://www.libraw.org/data/${_realname}-${pkgver}.tar.gz"
        "https://www.libraw.org/data/${_realname}-demosaic-pack-GPL2-0.18.8.tar.gz"
        "patch-libraw-0.22.3-gpl-demosaic-packs.diff"
	)
sha256sums=('789f3c33466210a1a0907f747a97c715d21bbf4af712f257fcbbd90111b227e4'
            '0b24bcf7bbb5d13fde58bb071f94dc9354be09bc44b2bba0698493065e99f8da'
            '5ef23708e76501d3d63bc47cd6cc25029dc9635204c242c704ff87912c541822'
	    )

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  patch -Np1 -i "${srcdir}/patch-libraw-0.22.3-gpl-demosaic-packs.diff"
  autoreconf -ifv
}

build() {
  [[ -d "${srcdir}/build-${MINGW_CHOST}" ]] && rm -rf "${srcdir}/build-${MINGW_CHOST}"
  mkdir -p "${srcdir}/build-${MINGW_CHOST}"
  cd "${srcdir}/build-${MINGW_CHOST}"

  CPPFLAGS+=" -DLIBRAW_BUILDLIB -D__STDC_LIMIT_MACROS"
  ../${_realname}-${pkgver}/configure \
      --prefix=${MINGW_PREFIX}/libraw-gpl2 \
      --build=${MINGW_CHOST} \
      --host=${MINGW_CHOST} \
      --enable-lcms \
      --enable-demosaic-pack-gpl2="${srcdir}/${_realname}-demosaic-pack-GPL2-0.18.8"

  make -j${MKJOBS}
}

check() {
  cd "${srcdir}/build-${MINGW_CHOST}"
  # tests/demosaic_test must report "GPL2: yes, GPL3: no"
  make check
  grep -q "GPL2: yes, GPL3: no" tests/demosaic_test.log || { cat tests/demosaic_test.log; return 1; }
}

package() {
  cd "${srcdir}/build-${MINGW_CHOST}"
  make DESTDIR="${pkgdir}" install
}
