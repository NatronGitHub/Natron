# Maintainer: The Natron developers
# Based on MSYS2's mingw-w64-ffmpeg (Alexey Pavlov, Zach Bacon, wirx6)

# FFmpeg for openfx-io, GPL-2.0-or-later: --enable-gpl without --enable-version3
# (MSYS2's own ffmpeg is GPLv3). The same version and configuration as Natron's
# macOS build (tools/MacPorts/multimedia/ffmpeg, variants +gpl2 +natronmini):
# no ass, bluray, network TLS, fontconfig, freetype, fribidi, SDL2, iconv, zimg
# or VMAF. Installed in the private prefix ${MINGW_PREFIX}/ffmpeg-gpl2, so that
# it doesn't clash with MSYS2's ffmpeg.

_realname=ffmpeg
pkgbase="mingw-w64-natron_${_realname}-gpl2"
pkgname="${MINGW_PACKAGE_PREFIX}-natron_${_realname}-gpl2"
pkgver=9.0.2
pkgrel=1
pkgdesc="Complete solution to record, convert and stream audio and video, GPLv2 build for Natron (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url="https://ffmpeg.org/"
license=('spdx:GPL-2.0-or-later')
options=('staticlibs' 'strip')
depends=("${MINGW_PACKAGE_PREFIX}-aom"
         "${MINGW_PACKAGE_PREFIX}-bzip2"
         "${MINGW_PACKAGE_PREFIX}-dav1d"
         "${MINGW_PACKAGE_PREFIX}-harfbuzz"
         "${MINGW_PACKAGE_PREFIX}-lame"
         "${MINGW_PACKAGE_PREFIX}-lcms2"
         "${MINGW_PACKAGE_PREFIX}-libmodplug"
         "${MINGW_PACKAGE_PREFIX}-librsvg"
         "${MINGW_PACKAGE_PREFIX}-libsoxr"
         "${MINGW_PACKAGE_PREFIX}-libtheora"
         "${MINGW_PACKAGE_PREFIX}-libvorbis"
         "${MINGW_PACKAGE_PREFIX}-libvpx"
         "${MINGW_PACKAGE_PREFIX}-libwebp"
         "${MINGW_PACKAGE_PREFIX}-libx264"
         "${MINGW_PACKAGE_PREFIX}-openh264"
         "${MINGW_PACKAGE_PREFIX}-openjpeg2"
         "${MINGW_PACKAGE_PREFIX}-opus"
         "${MINGW_PACKAGE_PREFIX}-snappy"
         "${MINGW_PACKAGE_PREFIX}-speex"
         "${MINGW_PACKAGE_PREFIX}-svt-av1"
         "${MINGW_PACKAGE_PREFIX}-vid.stab"
         "${MINGW_PACKAGE_PREFIX}-x265"
         "${MINGW_PACKAGE_PREFIX}-xvidcore"
         "${MINGW_PACKAGE_PREFIX}-xz"
         "${MINGW_PACKAGE_PREFIX}-zlib"
         "${MINGW_PACKAGE_PREFIX}-zvbi")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-nasm")
source=(https://ffmpeg.org/releases/${_realname}-${pkgver}.tar.xz)
sha256sums=('8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  # rename VERSION to avoid a conflict with the C++20 <version> header (as MSYS2 does)
  mv VERSION VERSION.txt
}

build() {
  # Do not let version.sh discover a surrounding git repository
  export GIT_DIR=/dev/null

  [[ -d "build-${MINGW_CHOST}" ]] && rm -rf "build-${MINGW_CHOST}"
  mkdir -p "${srcdir}/build-${MINGW_CHOST}"
  cd "${srcdir}/build-${MINGW_CHOST}"

  ../${_realname}-${pkgver}/configure \
    --prefix=${MINGW_PREFIX}/ffmpeg-gpl2 \
    --target-os=mingw32 \
    --arch=${CARCH%%-*} \
    --cc=${CC:-gcc} \
    --cxx=${CXX:-g++} \
    --disable-debug \
    --disable-stripping \
    --disable-doc \
    --enable-shared \
    --enable-static \
    --enable-pic \
    --enable-runtime-cpudetect \
    --enable-gpl \
    --enable-avfilter \
    --enable-swscale \
    --enable-swresample \
    --enable-dxva2 \
    --enable-d3d11va \
    --enable-lcms2 \
    --enable-libaom \
    --enable-libdav1d \
    --enable-libharfbuzz \
    --enable-libmodplug \
    --enable-libmp3lame \
    --enable-libopenh264 \
    --enable-libopenjpeg \
    --enable-libopus \
    --enable-librsvg \
    --enable-libsnappy \
    --enable-libsoxr \
    --enable-libspeex \
    --enable-libsvtav1 \
    --enable-libtheora \
    --enable-libvidstab \
    --enable-libvorbis \
    --enable-libvpx \
    --enable-libwebp \
    --enable-libx264 \
    --enable-libx265 \
    --enable-libxvid \
    --enable-libzvbi \
    --enable-lzma \
    --enable-zlib \
    --disable-libass \
    --disable-libbluray \
    --disable-gnutls \
    --disable-schannel \
    --disable-fontconfig \
    --disable-libfreetype \
    --disable-libfribidi \
    --disable-sdl2 \
    --disable-iconv \
    --disable-libzimg \
    --disable-libvmaf \
    --disable-libplacebo \
    --disable-opencl \
    --disable-vulkan \
    --logfile=config.log

  make
}

package() {
  cd "${srcdir}/build-${MINGW_CHOST}"
  make DESTDIR="${pkgdir}" install

  rm -f "${pkgdir}${MINGW_PREFIX}/ffmpeg-gpl2"/lib/*.def
  rm -f "${pkgdir}${MINGW_PREFIX}/ffmpeg-gpl2"/bin/*.lib

  local PREFIX_DEPS=$(cygpath -am ${MINGW_PREFIX})
  find "${pkgdir}${MINGW_PREFIX}/ffmpeg-gpl2/lib/pkgconfig" -name '*.pc' -exec sed -i -e"s|${PREFIX_DEPS}/ffmpeg-gpl2|${MINGW_PREFIX}/ffmpeg-gpl2|g;s|${PREFIX_DEPS}|${MINGW_PREFIX}|g" {} \;
}
