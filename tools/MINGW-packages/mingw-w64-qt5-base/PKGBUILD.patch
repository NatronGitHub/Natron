--- PKGBUILD.orig	2026-11-21 00:02:55
+++ PKGBUILD	2026-11-21 00:40:29
@@ -1,5 +1,20 @@
 # Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>
 
+# Natron: MSYS2's mingw-w64-qt5-base (PKGBUILD.orig, msys2/MINGW-packages
+# 7b1033939d, KDE kde/5.15 fbed962c31) with 1001-natron-qmutex-fix-lost-wakeup-arm64.patch,
+# the QMutex lost wake-up fix of NatronGitHub/Natron#1453 (#1451): Qt 5's non-futex
+# QMutex, which Windows always uses, can leave a thread asleep on an unlocked mutex
+# on weakly ordered CPUs. Only built for CLANGARM64 (Windows on ARM64, #1494): on
+# x86-64 every CAS is a full barrier, so UCRT64 is not affected in practice. No Qt 6
+# counterpart: MSYS2's qt6-base (6.12) uses WaitOnAddress futexes on Windows (#1453).
+# Same pkgname as MSYS2's, so it replaces the system package. pkgrel is 2.1: above
+# MSYS2's 5.15.19+kde+r96-2, below any MSYS2 rebuild (-3) or update. Then
+# natron_repo_install_overrides fails (NATRON_REPO_OVERRIDES_REQUIRED), rather than
+# bring back the hang: check that MSYS2's has the fix (a KDE kde/5.15 backport, see
+# #1546), or rebase this package on MSYS2's new PKGBUILD. Delete this
+# directory as soon as MSYS2's qt5-base has the fix (see "Packages that replace
+# MSYS2's" in ../README.md).
+
 # Use the right mkspecs file
 if [[ ${MINGW_PACKAGE_PREFIX} == *-clang-* ]]; then
   _platform=win32-clang-g++
@@ -13,10 +28,10 @@
          "${MINGW_PACKAGE_PREFIX}-${_realname}-debug")
 _qtver=5.15.19
 pkgver=5.15.19+kde+r96
-pkgrel=2
-pkgdesc="A cross-platform application and UI framework (mingw-w64)"
+pkgrel=2.1
+pkgdesc="A cross-platform application and UI framework (mingw-w64, Natron: QMutex lost wake-up fix)"
 arch=('any')
-mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
+mingw_arch=('clangarm64')
 url='https://www.qt.io/'
 msys2_repository_url='https://github.com/qt/qttools'
 msys2_references=(
